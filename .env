# ==============================================================================
# Personal Tracker Web - Environment Configuration
# ==============================================================================

# ── Application Metadata ──────────────────────────────────────────────────────
VITE_APP_TITLE="Personal Tracker"
VITE_APP_DESCRIPTION="International-grade personal tracker for habits, financial cash flow, strategic goals, and daily tasks with real-time analytics."
VITE_DEFAULT_THEME=light

# ── Dev Server Settings ───────────────────────────────────────────────────────
VITE_PORT=5173

# ── Backend & API Connection ──────────────────────────────────────────────────
# Base URL used by the frontend Axios client. Default is '/api' (proxied by Vite)
VITE_API_BASE_URL=/api
# Target backend server URL used by Vite proxy in development
VITE_BACKEND_URL=http://localhost:8080

# ── API Request Timeouts (in milliseconds) ───────────────────────────────────
VITE_API_TIMEOUT=6000
VITE_API_HEALTH_TIMEOUT=8000

# ── Debugging & Diagnostics ───────────────────────────────────────────────────
VITE_ENABLE_API_LOGGING=true

# ==============================================================================
# Personal Tracker Web - Development Environment (.env.development)
# ==============================================================================

# ── Application Metadata ──────────────────────────────────────────────────────
VITE_APP_TITLE="Personal Tracker (Dev)"
VITE_APP_DESCRIPTION="International-grade personal tracker for habits, financial cash flow, strategic goals, and daily tasks with real-time analytics."
VITE_DEFAULT_THEME=dark

# ── Dev Server Settings ───────────────────────────────────────────────────────
VITE_PORT=5173

# ── Backend & API Connection (Local Spring Boot Server) ───────────────────────
# VITE_API_BASE_URL=/api
# VITE_BACKEND_URL=http://localhost:8081

VITE_API_BASE_URL=https://personeltrackerapi-production.up.railway.app/api
VITE_BACKEND_URL=https://personeltrackerapi-production.up.railway.app


# ── API Request Timeouts (in milliseconds) ───────────────────────────────────
VITE_API_TIMEOUT=6000
VITE_API_HEALTH_TIMEOUT=8000

# ── Debugging & Diagnostics ───────────────────────────────────────────────────
VITE_ENABLE_API_LOGGING=true
